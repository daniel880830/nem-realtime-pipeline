# Copy to .env and fill in. All variables use the APP_ prefix.

# Required for `extract`: free key from https://platform.openelectricity.org.au
APP_OPENELECTRICITY_API_KEY=

# Contact sent in the Nominatim User-Agent (OpenStreetMap usage policy asks for one).
APP_NOMINATIM_CONTACT=you@example.com

# MQTT broker. Use localhost with `docker compose up broker`, or a public broker such as test.mosquitto.org.
APP_MQTT_HOST=localhost
APP_MQTT_PORT=1883

# Where the DuckDB warehouse, caches and raw snapshots are written.
APP_DATA_DIR=data
APP_REPORTS_DIR=reports
APP_CONFIG_FILE=config/pipeline.toml

# Host ports published by docker compose (change if they clash with other services).
APP_HOST_MQTT_PORT=1883
APP_HOST_DASHBOARD_PORT=8501
